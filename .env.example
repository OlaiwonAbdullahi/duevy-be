# =============================================================================
# Duevy Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Get these from your Supabase project > Settings > Database
# Use the "Connection string" (Transaction pooler recommended for serverless,
# Session pooler or direct for a long-running Node process).
# NOTE: URL-encode special characters in the password (/ & + , = %2F %26 %2B %2C).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"
#
# Connection pool — set these explicitly in production (append to the URL):
#   ?connection_limit=10&pool_timeout=10
# connection_limit is PER PROCESS (Prisma's default is 2 x CPUs + 1, which
# changes with the host). Budget it: (API instances + worker processes) x
# connection_limit must stay under the pooler's pool size (Supabase:
# Database > Connection pooling) with headroom for migrations and admin
# tools. pool_timeout (seconds) is how long a request waits for a free
# connection before failing fast with an error instead of hanging.
# Use Supabase's SESSION pooler (port 5432) or a direct connection, NOT the
# transaction pooler (port 6543 + pgbouncer=true): there Prisma wraps every
# query in its own transaction, ~5 round trips per query instead of 1. Measured
# with the database 60 ms away: dashboard pages ~320 ms instead of ~68 ms. The
# API warns at startup if pgbouncer=true is set. (If the transaction pooler is
# ever unavoidable, &pgbouncer=true is required with it; every lock this app
# takes is transaction-scoped, so it stays correct, just slow.)
#
# Put the API in the same region as the database: every sequential query
# costs one round trip between them, and dashboards take 1-2 in a row.

# For migrations, use the direct connection (not the pooler):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret-min-64-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-64-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# -----------------------------------------------------------------------------
# Google Sign-In (§2.3)
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Optional — while unset, POST /auth/google returns 501 NOT_IMPLEMENTED.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# -----------------------------------------------------------------------------
# Resend (email)
# Get your API key from https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Duevy <no-reply@duevy.app>"

# -----------------------------------------------------------------------------
# Payment rail
# ninejapay — 9jaPay virtual accounts (docs.9japay.com), the live provider.
# fake      — in-memory provider for local development, the seed and the
#             tests. Webhooks still use the real 9jaPay signature scheme.
#             Refused when NODE_ENV=production.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=ninejapay

# 9jaPay API. Keys come from the 9jaPay business dashboard
# (https://business.9japay.com) once Duevy is onboarded. Dev uses the sandbox;
# only production gets live keys and the live base URL 9jaPay gives you.
NINEJAPAY_BASE_URL="https://developer.test.9japay.com"
NINEJAPAY_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
# Also verifies webhooks: 9jaPay signs each delivery with this key. Point the
# dashboard's webhook URL (Settings → Developer) at /v1/webhooks/9japay.
NINEJAPAY_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
# Duevy's own 9jaPay business account ("Collection Account Number" on the
# dashboard): collections settle here and sweeps to each space's account are
# sent from here. Its name is looked up from 9jaPay when needed.
NINEJAPAY_BUSINESS_ACCOUNT_NUMBER="0000000000"
# 9jaPay's bank code, for transfers into a space's account.
NINEJAPAY_BANK_CODE="090629"
# A space's unswept collections below this (kobo) wait for the next daily sweep.
SWEEP_MIN_KOBO=100000
# 9jaPay's daily transfer limit on the business account, shared by every space's sweeps (₦10M).
NINEJAPAY_BUSINESS_DAILY_LIMIT_KOBO=1000000000
# Sandbox only: 9jaPay's simulate-deposit key. Enables POST /v1/dev/simulate-deposit (never on the live URL).
NINEJAPAY_SANDBOX_AUTH_KEY=

# -----------------------------------------------------------------------------
# Interswitch — the hackathon payment rail (set PAYMENT_PROVIDER=interswitch).
# Students pay by CARD via IPG Web Checkout; spaces get a permanent Interswitch
# Virtual Account and withdraw via the Payouts API. See docs/INTERSWITCH.md.
# Credentials come from the Quickteller Business portal → Developer Tools.
# -----------------------------------------------------------------------------
INTERSWITCH_ENV=test
INTERSWITCH_CLIENT_ID=""
INTERSWITCH_CLIENT_SECRET=""
# Web Checkout. TEST: MX6072 / 9405967. LIVE: MX153376 + your team's Pay Item ID.
INTERSWITCH_MERCHANT_CODE="MX6072"
INTERSWITCH_PAY_ITEM_ID="9405967"
INTERSWITCH_CURRENCY="566"
# Verifies dashboard webhooks (/v1/webhooks/interswitch). Required in live.
INTERSWITCH_WEBHOOK_SECRET=""
# Base URLs. Defaults below are the TEST hosts; set the live hosts for production.
INTERSWITCH_PASSPORT_URL="https://sandbox.interswitchng.com/passport/oauth/token"
INTERSWITCH_COLLECTIONS_URL="https://sandbox.interswitchng.com"
INTERSWITCH_PAYOUTS_URL="https://payouts-sandbox.interswitchng.com/api/v1/payouts"
INTERSWITCH_VA_URL="https://sandbox.interswitchng.com"
# inline-checkout.js host for the frontend. TEST below; LIVE: https://newwebpay.interswitchng.com/inline-checkout.js
INTERSWITCH_INLINE_CHECKOUT_URL="https://newwebpay.qa.interswitchng.com/inline-checkout.js"

# -----------------------------------------------------------------------------
# AI assistant — NVIDIA NIM (OpenAI-compatible). Drives the web chat + WhatsApp
# bot; every rep action runs as a tool over the REST API. See docs/AI.md.
# -----------------------------------------------------------------------------
AI_ENABLED=false
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# A current tool-calling model on build.nvidia.com (llama-3.3-70b was retired 2026-08-26).
AI_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
# Where the agent calls the Duevy API from (defaults to this process). Set if
# the API is reachable at a different internal URL.
# INTERNAL_API_BASE_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# WhatsApp bot — Baileys (unofficial WhatsApp Web client). See docs/WHATSAPP.md.
# Needs AI_ENABLED=true. Scan the QR printed to the logs on first start.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_DIR="./.whatsapp-auth"

# -----------------------------------------------------------------------------
# Didit — rep NIN + date of birth checks against NIMC (docs.didit.me).
# Required with PAYMENT_PROVIDER=ninejapay. With the fake provider, leave the
# key unset to use an in-memory verifier (every NIN matches).
# -----------------------------------------------------------------------------
DIDIT_BASE_URL="https://verification.didit.me"
DIDIT_API_KEY=""

# How long a checkout's one-time bank account stays open (1-1440 minutes).
CHECKOUT_EXPIRY_MINUTES=60

# Run the webhook queue worker and the reconciliation sweep inside the API
# process. Set to false when running them separately with `npm run worker`.
RUN_WORKERS=true
# Shared state across API instances (rate-limit counters). Required to run
# more than one API instance; docker-compose.yml sets it for production
# (redis://redis:6379). Leave unset locally for per-process limits.
# REDIS_URL="redis://localhost:6379"
# Webhook events processed concurrently per process (each makes a 9jaPay
# round trip). Keep well under connection_limit.
WEBHOOK_WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# KYC document storage (the rep's student ID card) — ImageKit (imagekit.io).
# Files are uploaded as PRIVATE and only ever shown to admins through signed
# links that expire after 10 minutes. 'memory' is for tests/local dev only and
# is refused in production.
# -----------------------------------------------------------------------------
FILE_STORAGE=imagekit
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_KYC_FOLDER="/duevy/kyc"
# Public images (avatars, poll images), served from the ImageKit CDN.
IMAGEKIT_PUBLIC_FOLDER="/duevy/public"

# -----------------------------------------------------------------------------
# Logging (pino, JSON). fatal | error | warn | info | debug | trace | silent
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# Reverse-proxy hops in front of the API (Render = 1). Defaults to 1 in
# production and 0 elsewhere; without it every client shares one rate-limit bucket.
# TRUST_PROXY=1

# Dedicated key for encrypting stored bank account numbers. Optional — falls
# back to a key derived from JWT_REFRESH_SECRET. Set it in production and never
# change it once account numbers are stored.
ENCRYPTION_KEY=""

# Cookie settings
COOKIE_SECURE=false          # Set to true in production (HTTPS)
COOKIE_SAME_SITE=lax         # lax | strict | none

# -----------------------------------------------------------------------------
# Feature flags for features outside the MVP. Off by default.
# Paid poll voting stays disabled regardless (no payment path in the MVP).
# -----------------------------------------------------------------------------
FEATURE_POLLS=false
FEATURE_REFERRALS=false

