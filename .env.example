# =============================================================================
# Duevy Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Get these from your Supabase project > Settings > Database
# Use the "Connection string" (Transaction pooler recommended for serverless,
# Session pooler or direct for a long-running Node process).
# NOTE: URL-encode special characters in the password (/ & + , = %2F %26 %2B %2C).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"

# For migrations, use the direct connection (not the pooler):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret-min-64-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-64-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# -----------------------------------------------------------------------------
# Google Sign-In (§2.3)
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Optional — while unset, POST /auth/google returns 501 NOT_IMPLEMENTED.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# -----------------------------------------------------------------------------
# Resend (email)
# Get your API key from https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Duevy <no-reply@duevy.app>"

# -----------------------------------------------------------------------------
# Payment rail
# bachs — Bachs Connect (docs.bachs.io), the live provider.
# fake  — in-memory provider for local development, the seed and the tests.
#         Webhooks still use the real Bachs signature scheme. Refused when
#         NODE_ENV=production.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=bachs

# Bachs API. Sandbox: https://sandbox-api.bachs.io with an sk_sandbox_ key.
# Live: https://api.bachs.io with an sk_live_ key. Going live is a key swap.
# Dev (.env, dev database) always uses sandbox; only production (Render, prod
# database) gets the live key. The server refuses to start with a live key
# outside NODE_ENV=production, or a key paired with the wrong base URL.
# The key needs these scopes: payments:write, payments:read,
# connected_accounts:write, connected_accounts:read, payouts:write,
# payouts:read, transfers:write, transfers:read.
BACHS_BASE_URL="https://sandbox-api.bachs.io"
BACHS_SECRET_KEY="sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx"

# Signing secret of the webhook endpoint pointed at /v1/webhooks/bachs. Bachs
# shows it once, when the endpoint is created. Register the endpoint with
# event_source "all" or Connect events (KYC, capabilities) never arrive.
BACHS_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# During a secret rotation Bachs keeps the old secret valid for 24h; put the
# outgoing one here until then. Optional.
BACHS_WEBHOOK_SECRET_PREVIOUS=""

# Reject signed webhook deliveries older/newer than this many seconds.
WEBHOOK_TOLERANCE_SECONDS=300

# How long a checkout's one-time bank account stays open (1-1440 minutes).
CHECKOUT_EXPIRY_MINUTES=60

# Run the webhook queue worker and the reconciliation sweep inside the API
# process. Set to false when running them separately with `npm run worker`.
RUN_WORKERS=true

# -----------------------------------------------------------------------------
# KYC document storage (the rep's student ID card) — ImageKit (imagekit.io).
# Files are uploaded as PRIVATE and only ever shown to admins through signed
# links that expire after 10 minutes. 'memory' is for tests/local dev only and
# is refused in production.
# -----------------------------------------------------------------------------
FILE_STORAGE=imagekit
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_KYC_FOLDER="/duevy/kyc"

# -----------------------------------------------------------------------------
# Logging (pino, JSON). fatal | error | warn | info | debug | trace | silent
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# Dedicated key for encrypting stored bank account numbers. Optional — falls
# back to a key derived from JWT_REFRESH_SECRET. Set it in production and never
# change it once account numbers are stored.
ENCRYPTION_KEY=""

# Cookie settings
COOKIE_SECURE=false          # Set to true in production (HTTPS)
COOKIE_SAME_SITE=lax         # lax | strict | none

# -----------------------------------------------------------------------------
# Feature flags for features outside the MVP. Off by default.
# Paid poll voting stays disabled regardless (no payment path in the MVP).
# -----------------------------------------------------------------------------
FEATURE_POLLS=false
FEATURE_ASSISTANT=false
FEATURE_REFERRALS=false

# -----------------------------------------------------------------------------
# Duey (AI chat assistant) — classification backend. See src/lib/llm/.
# 'ollama'  — local/dev Ollama instance (Gemma or any model it serves)
# 'gemini'  — Google's Gemini API, called natively (no OpenAI-compat shim)
# 'hosted'  — any other OpenAI-chat-completions-compatible endpoint
#             (self-hosted vLLM box, etc.)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama          # ollama | gemini | hosted
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma2:9b"

# Only used when LLM_PROVIDER=gemini. Get a key from https://aistudio.google.com/apikey
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-2.0-flash"

# Only used when LLM_PROVIDER=hosted (generic OpenAI-compatible endpoints only —
# NOT for Gemini; use the GEMINI_* vars above for that instead)
LLM_HOSTED_BASE_URL="https://your-openai-compatible-endpoint.example.com/v1"
LLM_HOSTED_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_HOSTED_MODEL="your-model-name"
LLM_TIMEOUT_MS=8000
