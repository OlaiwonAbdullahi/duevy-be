# =============================================================================
# Duevy Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Get these from your Supabase project > Settings > Database
# Use the "Connection string" (Transaction pooler recommended for serverless,
# Session pooler or direct for a long-running Node process).
# NOTE: URL-encode special characters in the password (/ & + , = %2F %26 %2B %2C).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"

# For migrations, use the direct connection (not the pooler):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret-min-64-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-64-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# -----------------------------------------------------------------------------
# Redis (Docker Compose default)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Google Sign-In (§2.3)
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Optional — while unset, POST /auth/google returns 501 NOT_IMPLEMENTED.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# -----------------------------------------------------------------------------
# Resend (email)
# Get your API key from https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Duevy <no-reply@duevy.app>"

# -----------------------------------------------------------------------------
# Anchor (getanchor.co) — the sole payment processor. See src/lib/anchor.ts.
# Generate keys under Settings → API Keys in the Anchor dashboard.
# -----------------------------------------------------------------------------
ANCHOR_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANCHOR_BASE_URL="https://api.sandbox.getanchor.co"

# Webhook signature validation for POST /webhooks/anchor. This is the `token`
# you set when registering the webhook — Anchor caps it at 10 CHARACTERS, so a
# longer value can never be registered and would fail every check.
ANCHOR_WEBHOOK_SECRET="whsec12345"

# Duevy Labs' own Anchor deposit account. Every student payment settles here
# first (Pay With Transfer has no settlement destination), and it funds the book
# transfers that remit each department's share on to its own account. Duevy's
# margin is whatever stays behind, so there is no separate revenue account.
ANCHOR_SETTLEMENT_ACCOUNT_ID="012345678901234-anc_acc"

# Which bank issues the checkout account number: wema | providus | gtb |
# ninepsb | corestep | column | circle | anchor. Optional — Anchor picks one if
# unset, but the student sees this bank's name when they transfer, so a
# recognisable one is worth pinning. Leave blank to let Anchor decide.
ANCHOR_VA_PROVIDER="providus"

# How long a checkout stays open, in seconds (PRD §5.2 — 30 minutes). Pay With
# Transfer takes this as `expiryTime` and enforces it, so the countdown is real
# and a transfer arriving after it genuinely cannot land.
ANCHOR_VA_EXPIRY_SECONDS="1800"

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# Cookie settings
COOKIE_SECURE=false          # Set to true in production (HTTPS)
COOKIE_SAME_SITE=lax         # lax | strict | none

# -----------------------------------------------------------------------------
# Duey (AI chat assistant) — classification backend. See src/lib/llm/.
# 'ollama'  — local/dev Ollama instance (Gemma or any model it serves)
# 'gemini'  — Google's Gemini API, called natively (no OpenAI-compat shim)
# 'hosted'  — any other OpenAI-chat-completions-compatible endpoint
#             (self-hosted vLLM box, etc.)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama          # ollama | gemini | hosted
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma2:9b"

# Only used when LLM_PROVIDER=gemini. Get a key from https://aistudio.google.com/apikey
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-2.0-flash"

# Only used when LLM_PROVIDER=hosted (generic OpenAI-compatible endpoints only —
# NOT for Gemini; use the GEMINI_* vars above for that instead)
LLM_HOSTED_BASE_URL="https://your-openai-compatible-endpoint.example.com/v1"
LLM_HOSTED_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_HOSTED_MODEL="your-model-name"
LLM_TIMEOUT_MS=8000
