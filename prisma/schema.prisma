// =============================================================================
// Duevy — Prisma Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  student
  rep
  admin
}

enum RepApplicationStatus {
  none
  pending
  approved
  rejected
}

enum AdminSubRole {
  super_admin
  compliance_officer
  support_lead
}

enum SpaceKind {
  department
  association
  faculty
  club
}

enum SpaceMembershipKind {
  member
  guest
}

enum RepRole {
  lead
  co
}

enum EmblemHue {
  emerald
  indigo
  amber
  rose
  slate
}

enum SpaceTheme {
  emerald
  ocean
  royal
  crimson
  tangerine
}

// The kind of payment item a due is. Stored in the dues.category column.
enum DueType {
  handout
  departmental_due
  exam_levy
  lab_manual
  association_due
  departmental_wear
  trip_fee
  clearance
  other
}

enum RepDueStatus {
  draft
  active
  closed
}

enum PayMethod {
  wallet
  card
  online
}

enum TxnType {
  due
  topup
  referral
  withdrawal
  refund
  vote
  card_verification
}

enum TxnStatus {
  completed
  pending
  failed
}

// A withdrawal's lifecycle. Legal moves live in src/lib/stateMachine.ts:
// pending → processing → success | failed | reversed (plus pending → failed).
enum PayoutStatus {
  pending
  processing
  success
  failed
  reversed
}

// A checkout's lifecycle: pending → paid | expired | underpaid (plus the
// late-money exceptions documented in src/lib/stateMachine.ts).
enum CheckoutStatus {
  pending
  paid
  expired
  underpaid
}

// The DB-backed job queue's states for an inbound webhook event.
enum WebhookStatus {
  received
  processing
  processed
  failed
  dead
}

enum PayoutApprovalDecision {
  approved
  rejected
}

enum LedgerEntryType {
  due_payment // credit: a student's payment, at face value
  refund
  payout // debit: what was sent to the rep's bank
  payout_fee // debit: the withdrawal fee, deducted from the withdrawal
  payout_reversal // credit: a failed or reversed withdrawal, restored in full
  manual_credit
}

enum LedgerDirection {
  credit
  debit
}

enum PollStatus {
  draft
  active
  closed
}

enum ReferralStatus {
  pending
  joined
  paid
}

enum NotificationKind {
  due_reminder
  payment_received
  join_request
  payout_completed
  poll_milestone
  referral_earned
  system
}

enum NotificationTone {
  brand
  amber
  rose
}

// Duevy's own review of a document Bachs doesn't check (the rep's student ID).
enum DocumentReviewStatus {
  pending
  approved
  rejected
}

enum KycStatus {
  unverified
  pending
  verified
  rejected
}

// Anchor's verification levels, named as the API names them — NOT as the prose
// docs do. The `level` enum accepts only TIER_2 and TIER_3; there is no TIER_1
// to submit. See the callout in src/lib/anchor.ts before renaming anything.
//
//   tier_0  the customer exists (name, address, email, phone) but is unverified.
//   tier_2  BVN + date of birth + gender. Automatic, ₦50, capped at ₦300,000.
//   tier_3  a government ID document. Manual review, ₦200, and UNLIMITED —
//           which is the whole reason to offer the upgrade.
enum KycTier {
  tier_0
  tier_2
  tier_3
}

enum DisputeStatus {
  open
  under_review
  resolved
}

enum DisputeType {
  payment_not_reflecting
  non_remittance
  refund_request
}

enum RiskTier {
  low
  medium
  high
}

enum FlagStatus {
  pending
  paid
  voided
  clawed_back
}

enum ReportScope {
  financial_summary
  space_collection
  rep_performance
  full_ledger
}

enum ReportFormat {
  csv
  pdf
}

enum ReportStatus {
  generating
  ready
  expired
}

enum SpaceJoinRequestStatus {
  pending
  approved
  rejected
}

enum AuditAction {
  payout_requested
  due_published
  due_closed
  due_created
  poll_created
  members_approved
  profile_updated
  rep_invited
  rep_removed
  code_regenerated
  lead_transferred
  space_archived
  due_reassigned
  payout_approval_cast
  payout_disbursement_started
  payout_cancelled
  beneficiary_added
  beneficiary_removed
}

enum AssistantIntent {
  pay_dues
  join_department
  check_balance
  view_history
  contact_rep
  fund_wallet
  create_due
  rep_summary
  unknown
}

enum AssistantRole {
  user
  assistant
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id                      String                @id @default(cuid())
  name                    String
  email                   String                @unique
  emailVerified           Boolean               @default(false)
  passwordHash            String?
  phone                   String?
  avatarUrl               String?
  // `role` is the coarse label carried in the access token (admin vs not).
  // Permissions are ADDITIVE: every user is a student; `isRep` is granted on
  // top once an admin approves their rep application, and is what rep-only
  // actions (creating a space) check. Space-level authority is SpaceRep.
  role                    Role                  @default(student)
  isRep                   Boolean               @default(false)
  repApplicationStatus    RepApplicationStatus  @default(none)
  adminSubRole            AdminSubRole?
  // Multi-school ready; launch is LAUTECH only.
  institution             String                @default("LAUTECH")
  matricNo                String?
  level                   String?
  notificationPrefs       Json? // §3.4 — email/push toggles; null = defaults
  referralCode            String?               @unique
  // Rep identity on Bachs Connect. Each rep is a recipient Connect account
  // (bachsAccountId) whose representative person (bachsPersonId — the
  // provider reference for KYC) carries the rep's NIN (and a BVN only if Bachs
  // later asks for one). Collections settle into this account as destination
  // charges and withdrawals are paid out of it.
  //
  // THE NIN, BVN AND DATE OF BIRTH ARE NEVER PERSISTED. They pass through to
  // Bachs in the KYC request and nowhere else; only the outcome is stored.
  bachsAccountId          String?               @unique
  bachsPersonId           String?
  // Bachs reports these separately: the person's verification, and whether the
  // account may pay out. A rep can collect only when both are true.
  kycStatus               KycStatus             @default(unverified)
  bachsPayoutsActive      Boolean               @default(false)
  kycSubmittedAt          DateTime?
  kycResolvedAt           DateTime?
  kycRejectionReason      String?
  kycAttempts             Int                   @default(0)
  kycRetryLockedUntil     DateTime? // §9.2 — 24h lock after 3 consecutive failures
  // Field keys Bachs still asks for on the rep's account (e.g. a BVN or an ID
  // document), refreshed on every identity event, so the rep can be told.
  kycRequirementsDue      String[]              @default([])
  governmentIdSubmittedAt DateTime? // an ID document forwarded to Bachs on request
  // The rep's student ID card — Duevy's own check, not Bachs's. Uploaded at
  // KYC time to private storage (ImageKit) and reviewed by an admin; a space
  // can only collect once it is approved. Only the storage reference is kept.
  studentIdFileId         String?
  studentIdFilePath       String?
  studentIdMimeType       String?
  studentIdStatus         DocumentReviewStatus?
  studentIdUploadedAt     DateTime?
  studentIdReviewedAt     DateTime?
  studentIdReviewedById   String?
  studentIdReviewNote     String?
  // --- Legacy (Anchor era). Read-only; kept so historical rows and any
  // balance still held at Anchor stay traceable. Nothing writes these.
  anchorCustomerId        String?               @unique
  kycTier                 KycTier               @default(tier_0)
  kycPendingTier          KycTier?
  kycDocUrls              String[]              @default([])
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String? // Anchor's enum casing, e.g. "OYO", "AKWA_IBOM"
  postalCode              String?
  isSuspended             Boolean               @default(false)
  suspendedReason         String?
  isDeactivated           Boolean               @default(false)
  deactivatedReason       String?
  termsAcceptedAt         DateTime?
  termsVersion            String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  // Relations
  refreshTokens          RefreshToken[]
  emailVerifications     EmailVerification[]
  passwordResets         PasswordReset[]
  spaceMemberships       SpaceMembership[]
  spaceReps              SpaceRep[]
  spaceJoinRequests      SpaceJoinRequest[]
  duePayments            DuePayment[]
  transactions           Transaction[]
  notifications          Notification[]
  pollVotes              PollVote[]
  referralsMade          Referral[]              @relation("referrer")
  referralReceived       Referral?               @relation("referred")
  discountCodes          DiscountCode[]
  adminPermissions       AdminPermission?
  disputes               Dispute[]
  idempotencyKeys        IdempotencyKey[]
  sessions               Session[]
  assistantConversations AssistantConversation[]
  assignedDues           Due[]                   @relation("DueAssignedRep")
  requestedPayouts       Payout[]                @relation("PayoutRequestedBy")
  payoutApprovals        PayoutApproval[]
  checkouts              Checkout[]
  receipts               Receipt[]

  @@index([institution])
  @@index([studentIdStatus])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  device    String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  device     String?
  ip         String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Spaces
// ---------------------------------------------------------------------------

model Space {
  id                   String     @id @default(cuid())
  name                 String
  short                String // 2-6 chars, monogram
  kind                 SpaceKind
  hue                  EmblemHue  @default(emerald)
  theme                SpaceTheme @default(emerald)
  about                String?
  faculty              String?
  school               String // display name of the school
  // Institution code the space belongs to. Multi-school ready; launch is
  // LAUTECH only.
  institution          String     @default("LAUTECH")
  joinCode             String     @unique
  requireApproval      Boolean    @default(false)
  isArchived           Boolean    @default(false)
  archivedAt           DateTime?
  archivedReason       String?
  payoutsFrozen        Boolean    @default(false)
  frozenReason         String?
  // --- Legacy (Anchor era). Read-only. Under Bachs a space has no account of
  // its own: collections settle into the LEAD REP's Connect account and the
  // space's share is tracked by its ledger. These stay so any balance still
  // held in an Anchor deposit account can be traced and paid out by an admin.
  anchorAccountId      String?    @unique
  anchorAccountNumber  String?
  anchorBankName       String?
  anchorAccountStatus  String? // ACTIVE | BLOCKED | CLOSED | DEPRECATED
  // The rep's payout bank account, registered with Anchor as a CounterParty.
  anchorCounterPartyId String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  memberships    SpaceMembership[]
  reps           SpaceRep[]
  joinRequests   SpaceJoinRequest[]
  dues           Due[]
  beneficiaries  PayoutBeneficiary[]
  payouts        Payout[]
  polls          Poll[]
  auditLogs      SpaceAuditLog[]
  repApplication RepApplication?
  ledgerEntries  LedgerEntry[]
  checkouts      Checkout[]
  receipts       Receipt[]

  @@index([institution])
  @@map("spaces")
}

model SpaceMembership {
  id       String              @id @default(cuid())
  userId   String
  spaceId  String
  kind     SpaceMembershipKind @default(member)
  joinedAt DateTime            @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_memberships")
}

model SpaceRep {
  id      String   @id @default(cuid())
  userId  String
  spaceId String
  role    RepRole  @default(co)
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_reps")
}

model SpaceJoinRequest {
  id         String                 @id @default(cuid())
  userId     String
  spaceId    String
  status     SpaceJoinRequestStatus @default(pending)
  createdAt  DateTime               @default(now())
  resolvedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_join_requests")
}

// Holds pending rep application data (submitted at signup, provisioned on admin approve)
model RepApplication {
  id           String               @id @default(cuid())
  userId       String               @unique
  spaceId      String?              @unique // set once space is provisioned on approval
  spaceName    String
  spaceShort   String
  spaceKind    SpaceKind
  school       String
  faculty      String?
  theme        SpaceTheme
  coRepInvites String[]             @default([])
  referralCode String?
  status       RepApplicationStatus @default(pending)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())

  space Space? @relation(fields: [spaceId], references: [id])

  @@map("rep_applications")
}

model SpaceAuditLog {
  id          String      @id @default(cuid())
  spaceId     String
  actorId     String
  actorName   String
  actorRole   RepRole? // the actor's SpaceRep role at write time; null for historical rows
  action      AuditAction
  description String
  createdAt   DateTime    @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, createdAt])
  @@map("space_audit_logs")
}

// ---------------------------------------------------------------------------
// Dues
// ---------------------------------------------------------------------------

model Due {
  id             String       @id @default(cuid())
  spaceId        String
  title          String
  note           String?
  amount         Int // kobo
  dueDate        DateTime // YYYY-MM-DD — the deadline
  category       DueType // exposed as `type` in the API
  status         RepDueStatus @default(draft)
  allowGuests    Boolean      @default(false)
  publishedAt    DateTime?
  closedAt       DateTime?
  lastRemindedAt DateTime? // §7.7 reminder cooldown
  assignedRepId  String? // the rep whose due-scoped payout access this due is scoped to
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  payments      DuePayment[]
  payouts       Payout[]
  assignedRep   User?          @relation("DueAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]
  checkoutItems CheckoutItem[]

  @@index([spaceId])
  @@index([assignedRepId])
  @@map("dues")
}

model DuePayment {
  id                    String    @id @default(cuid())
  userId                String
  dueId                 String
  txnId                 String?   @unique
  paidAt                DateTime  @default(now())
  // NOT unique: one checkout can settle several dues at once (PRD §5.2), and
  // every DuePayment it creates shares the checkout's reference. Uniqueness is
  // carried by @@unique([userId, dueId]) below — a due is paid once per user.
  reference             String
  checkoutId            String? // the checkout that settled it; null for legacy and manual-credit rows
  amountPaid            Int // kobo — this line's share of what the student paid (face + its share of the fee)
  processingFee         Int // kobo — legacy split of the fee; 0 for Bachs-era rows (Duevy absorbs Bachs's fee)
  duevyFee              Int // kobo — this line's share of the checkout service charge
  netToSpace            Int // kobo — the face value, credited to the space in full
  // --- Legacy (Anchor era) checkout/remittance fields. Nothing writes these now.
  payWithTransferId     String?
  checkoutAccountNumber String?
  checkoutExpiresAt     DateTime?
  settledAt             DateTime?
  remittedAt            DateTime?
  remitTransferId       String?

  user          User          @relation(fields: [userId], references: [id])
  due           Due           @relation(fields: [dueId], references: [id])
  transaction   Transaction?  @relation(fields: [txnId], references: [id])
  checkout      Checkout?     @relation(fields: [checkoutId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([userId, dueId])
  @@index([dueId])
  @@index([reference])
  @@index([checkoutId])
  @@map("due_payments")
}

// ---------------------------------------------------------------------------
// Checkouts — one bank transfer settling one or more dues
// ---------------------------------------------------------------------------

// A student's basket of dues from one space, paid by ONE transfer into a
// one-time bank account opened for this checkout. Fees are computed server
// side when it is created and never change afterwards.
model Checkout {
  id                   String         @id @default(cuid())
  reference            String         @unique // our reference; also the provider's
  userId               String
  spaceId              String
  status               CheckoutStatus @default(pending)
  faceKobo             Int // sum of the dues' face amounts — what the space receives
  feeKobo              Int // 2% + ₦20, on top
  totalKobo            Int // faceKobo + feeKobo — what the student must transfer
  receivedKobo         Int? // what the provider reported as received
  overpaidKobo         Int            @default(0)
  // The sorted due ids, so a repeat request for the same basket returns the
  // still-open checkout instead of opening a second account.
  dueSetKey            String
  provider             String         @default("bachs")
  providerCheckoutId   String?        @unique
  providerChargeId     String?
  // The rep's Connect account the face amount is routed to (destination charge).
  destinationAccountId String?
  // The one-time bank account the student transfers into.
  vaAccountNumber      String?
  vaBankName           String?
  vaAccountName        String?
  expiresAt            DateTime
  paidAt               DateTime?
  expiredAt            DateTime?
  underpaidAt          DateTime?
  // Set on anything a human has to look at: underpaid, overpaid, late money,
  // or a paid checkout whose dues had already been settled elsewhere.
  needsReview          Boolean        @default(false)
  reviewReason         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  space       Space          @relation(fields: [spaceId], references: [id])
  items       CheckoutItem[]
  duePayments DuePayment[]
  receipt     Receipt?

  @@index([userId, status])
  @@index([spaceId, status])
  @@index([status, expiresAt])
  @@index([needsReview])
  @@map("checkouts")
}

model CheckoutItem {
  id         String @id @default(cuid())
  checkoutId String
  dueId      String
  faceKobo   Int // the due's face amount at the time of checkout
  feeKobo    Int // this line's share of the checkout fee (sums to Checkout.feeKobo)

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  due      Due      @relation(fields: [dueId], references: [id])

  @@unique([checkoutId, dueId])
  @@index([dueId])
  @@map("checkout_items")
}

// Issued once per paid checkout. The PDF is rendered on demand from the
// checkout's own rows, so the receipt can never disagree with the ledger.
model Receipt {
  id         String   @id @default(cuid())
  number     String   @unique
  checkoutId String   @unique
  userId     String
  spaceId    String
  totalKobo  Int
  issuedAt   DateTime @default(now())

  checkout Checkout @relation(fields: [checkoutId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  space    Space    @relation(fields: [spaceId], references: [id])

  @@index([userId, issuedAt])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// Wallet & Transactions
// ---------------------------------------------------------------------------

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  type          TxnType
  title         String
  detail        String?
  amount        Int // kobo, signed
  method        String // "Bank transfer" | legacy: "Wallet", "Anchor", "Bachs"
  status        TxnStatus @default(pending)
  reference     String    @unique
  spaceId       String?
  refundOfTxnId String? // set on `type: refund` rows — the transaction this refund reverses
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  duePayment    DuePayment?
  refundOf      Transaction?  @relation("TransactionRefunds", fields: [refundOfTxnId], references: [id])
  refunds       Transaction[] @relation("TransactionRefunds")
  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([refundOfTxnId])
  @@map("transactions")
}

model PendingPayment {
  id        String   @id @default(cuid())
  reference String   @unique
  userId    String
  type      String // "topup" | "due_payment" | "poll_vote"
  metadata  Json // stores dueId, pollId, the checkout virtual account, etc.
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([reference])
  @@map("pending_payments")
}

// Inbound provider events, and the DB-backed job queue that processes them.
//
// Bachs delivers at least once, so the webhook route only verifies the
// signature and inserts here (deduplicated by the provider's event id), then
// returns 200. src/jobs/webhookWorker.ts claims rows with
// FOR UPDATE SKIP LOCKED and retries failures with backoff until `dead`.
// Handlers are idempotent, so a retry or a duplicate is always safe.
model WebhookEvent {
  id              String        @id @default(cuid())
  provider        String        @default("bachs")
  providerEventId String
  type            String
  payload         Json
  status          WebhookStatus @default(received)
  attempts        Int           @default(0)
  nextAttemptAt   DateTime      @default(now())
  lockedAt        DateTime?
  error           String?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([status, nextAttemptAt])
  @@index([type, receivedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Payouts & Bank Accounts
// ---------------------------------------------------------------------------

// A bank account the space can withdraw to: the rep's own, a lecturer's, a
// vendor's. Name enquiry runs when it is added, so `accountName` is always the
// bank's. Registered as a payout destination on the lead rep's Bachs account;
// if the lead changes, it is re-registered on the new lead's account at the
// next withdrawal.
model PayoutBeneficiary {
  id                  String   @id @default(cuid())
  spaceId             String
  label               String? // the rep's own note, e.g. "Dr. Adeyemi (HOD)"
  bankCode            String
  bankName            String
  accountNumber       String // stored encrypted
  accountNumberMasked String // "•••• 4021"
  accountName         String
  bachsDestinationId  String?
  bachsAccountId      String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([spaceId, createdAt])
  @@map("payout_beneficiaries")
}

model Payout {
  id                String       @id @default(cuid())
  spaceId           String
  dueId             String? // null = space-wide (lead-only); set = due-scoped
  amount            Int // kobo — the GROSS debit against the space's ledger balance
  reference         String       @unique // ours; also the provider reference and idempotency key
  status            PayoutStatus @default(pending)
  accountMasked     String // "GTBank •••• 4021"
  // Who it was sent to, fixed when the withdrawal is requested so a later
  // edit or removal of the beneficiary can't redirect it.
  beneficiaryId     String?
  accountName       String?
  destinationId     String? // the provider payout destination it is sent to
  note              String?
  requestedById     String?
  failureReason     String?
  // amount = feeKobo + netKobo. netKobo is sent to the bank; feeKobo is
  // Duevy's withdrawal fee. Both are debited from the ledger when the
  // withdrawal is created and credited back in full if it fails.
  feeKobo           Int          @default(0)
  netKobo           Int          @default(0)
  // Set to spaceId while the payout is pending/processing and cleared when it
  // ends. Unique, so a space can never have two withdrawals in flight — the
  // database-level backstop behind the advisory lock in withdrawal.service.
  activeSpaceId     String?      @unique
  provider          String       @default("bachs")
  providerPayoutId  String?      @unique
  providerAccountId String? // the rep's Connect account it was paid out of
  providerFeeKobo   Int? // what Bachs charged on top, from the payout response
  // Once the payout succeeds, Duevy's fee (less Bachs's own payout fee) is
  // moved from the rep's account to the platform. Signed: positive = swept to
  // the platform, negative = the platform topped the account up.
  feeSettlementKobo Int?
  feeSettledAt      DateTime?
  requestedAt       DateTime     @default(now())
  processingAt      DateTime?
  cancelledAt       DateTime?
  settledAt         DateTime?
  failedAt          DateTime?
  reversedAt        DateTime?
  // --- Legacy (Anchor era) fee split. Nothing writes these now.
  duevyFeeKobo      Int          @default(0)
  anchorFeeKobo     Int          @default(0)
  stampDutyKobo     Int          @default(0)
  netSentKobo       Int          @default(0)
  anchorTransferId  String?

  space         Space              @relation(fields: [spaceId], references: [id])
  due           Due?               @relation(fields: [dueId], references: [id], onDelete: SetNull)
  beneficiary   PayoutBeneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  requestedBy   User?              @relation("PayoutRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvals     PayoutApproval[]
  ledgerEntries LedgerEntry[]

  @@index([spaceId, requestedAt])
  @@index([status, requestedAt])
  @@index([dueId])
  @@map("payouts")
}

model PayoutApproval {
  id        String                 @id @default(cuid())
  payoutId  String
  repUserId String
  decision  PayoutApprovalDecision
  decidedAt DateTime               @default(now())

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  rep    User   @relation(fields: [repUserId], references: [id], onDelete: Cascade)

  @@unique([payoutId, repUserId])
  @@index([payoutId])
  @@map("payout_approvals")
}

// Append-only ledger per space — the source of truth for a space's balance,
// which is always derived (SUM(credit) − SUM(debit), see ledger.service.ts)
// and never stored. A Postgres trigger rejects UPDATE and DELETE on this
// table, so a correction is always a new compensating entry. The two unique
// keys make every write idempotent: one collection credit per DuePayment and
// one entry of each type per withdrawal, however often a webhook is replayed.
model LedgerEntry {
  id           String          @id @default(cuid())
  spaceId      String
  dueId        String?
  txnId        String?
  duePaymentId String?
  payoutId     String?
  type         LedgerEntryType
  direction    LedgerDirection
  amountKobo   Int // always positive; direction gives the sign
  grossKobo    Int?
  feeKobo      Int?
  netKobo      Int?
  reference    String // Transaction.reference / Payout.reference — traceability
  description  String
  actorId      String? // set for refund / manual_credit (the admin who acted)
  createdAt    DateTime        @default(now())

  space      Space        @relation(fields: [spaceId], references: [id])
  due        Due?         @relation(fields: [dueId], references: [id])
  txn        Transaction? @relation(fields: [txnId], references: [id])
  duePayment DuePayment?  @relation(fields: [duePaymentId], references: [id])
  payout     Payout?      @relation(fields: [payoutId], references: [id])

  @@unique([type, duePaymentId])
  @@unique([type, payoutId])
  @@index([spaceId, createdAt])
  @@index([dueId])
  @@index([reference])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Polls & Voting
// ---------------------------------------------------------------------------

model Poll {
  id            String     @id @default(cuid())
  spaceId       String
  title         String
  description   String?
  deadline      DateTime
  status        PollStatus @default(draft)
  membersOnly   Boolean    @default(true)
  paid          Boolean    @default(false)
  amountPerVote Int        @default(0) // kobo
  slug          String     @unique
  totalVotes    Int        @default(0)
  revenue       Int        @default(0) // kobo
  coverImageUrl String?
  themeColor    String?
  publishedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  space      Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  categories PollCategory[]

  @@index([spaceId])
  @@map("polls")
}

model PollCategory {
  id        String   @id @default(cuid())
  pollId    String
  title     String
  imageUrl  String?
  createdAt DateTime @default(now())

  poll     Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  nominees Nominee[]

  @@index([pollId])
  @@map("poll_categories")
}

model Nominee {
  id         String  @id @default(cuid())
  categoryId String
  name       String
  imageUrl   String?
  bio        String?
  code       String?
  votes      Int     @default(0)

  category  PollCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pollVotes PollVote[]

  @@index([categoryId])
  @@map("nominees")
}

model PollVote {
  id         String   @id @default(cuid())
  userId     String
  nomineeId  String
  categoryId String
  quantity   Int      @default(1)
  amountPaid Int      @default(0) // kobo
  txnRef     String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  nominee Nominee @relation(fields: [nomineeId], references: [id])

  @@index([userId, categoryId])
  @@map("poll_votes")
}

// ---------------------------------------------------------------------------
// Referrals
// ---------------------------------------------------------------------------

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referredId String         @unique
  status     ReferralStatus @default(pending)
  reward     Int            @default(0) // kobo — 0 until paid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  referrer User @relation("referrer", fields: [referrerId], references: [id])
  referred User @relation("referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

// Referral reward as a redeemable discount, replacing the old wallet-credit
// model. Owned by exactly one user (the referrer); redeemable only against
// their own due payments. `amountKobo` reduces what the payer is charged —
// capped at the due's own fee (see POST /dues/:dueId/pay) so Duevy never
// pays out of pocket beyond its own platform cut; the rep's netToSpace is
// always untouched by a discount.
model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  amountKobo Int
  redeemedAt DateTime?
  dueId      String? // which due it was redeemed against, once used
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("discount_codes")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  tone      NotificationTone @default(brand)
  title     String
  detail    String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------

model Dispute {
  id              String        @id @default(cuid())
  type            DisputeType
  openedById      String
  openedByName    String
  openedByEmail   String
  department      String?
  status          DisputeStatus @default(open)
  slaDays         Int           @default(3)
  txnReference    String?
  description     String
  studentEvidence Json?
  repEvidence     Json?
  claimedById     String?
  resolution      String?
  refundTxnId     String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  openedBy User @relation(fields: [openedById], references: [id])

  @@index([status])
  @@map("disputes")
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model AdminPermission {
  id             String  @id @default(cuid())
  userId         String  @unique
  userManagement Boolean @default(false)
  payouts        Boolean @default(false)
  disputes       Boolean @default(false)
  overrides      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_permissions")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  role      String
  action    String
  target    String?
  ip        String?
  device    String?
  severity  String   @default("info") // info | warning | critical
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model ReferralFlag {
  id           String     @id @default(cuid())
  referrerId   String
  referredId   String
  referrerName String
  referredName String
  label        String // rule that fired
  description  String
  amount       Int // kobo at stake
  status       FlagStatus @default(pending)
  note         String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([status])
  @@map("referral_flags")
}

model Report {
  id            String       @id @default(cuid())
  requestedById String
  scope         ReportScope
  format        ReportFormat
  status        ReportStatus @default(generating)
  fromDate      DateTime
  toDate        DateTime
  spaceId       String?
  downloadUrl   String?
  fileSize      Int?
  generatedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([requestedById])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

// A key is CLAIMED (responseStatus 0) before the handler runs, so a concurrent
// duplicate gets 409 instead of running the handler twice; the response is
// stored on completion. requestHash binds the key to the exact request, so a
// reused key with a different body is rejected rather than replayed.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  userId         String
  requestHash    String?
  responseStatus Int // 0 = in progress
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Duey — AI chat assistant
// ---------------------------------------------------------------------------

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AssistantRole
  content        String
  intent         AssistantIntent?
  params         Json?
  confidence     Float?
  createdAt      DateTime         @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}
