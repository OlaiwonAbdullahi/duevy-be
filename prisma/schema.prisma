// =============================================================================
// Duevy — Prisma Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  student
  rep
  admin
}

enum RepApplicationStatus {
  none
  pending
  approved
  rejected
}

enum AdminSubRole {
  super_admin
  compliance_officer
  support_lead
}

enum SpaceKind {
  department
  association
  faculty
  club
}

enum SpaceMembershipKind {
  member
  guest
}

enum RepRole {
  lead
  co
}

enum EmblemHue {
  emerald
  indigo
  amber
  rose
  slate
}

enum SpaceTheme {
  emerald
  ocean
  royal
  crimson
  tangerine
}

enum DueCategory {
  levy
  dinner
  handout
  welfare
  sport
}

enum RepDueStatus {
  draft
  active
  closed
}

enum PayMethod {
  wallet
  card
  online
}

enum TxnType {
  due
  topup
  referral
  withdrawal
  refund
  vote
  card_verification
}

enum TxnStatus {
  completed
  pending
  failed
}

enum PayoutStatus {
  pending_approval
  processing
  completed
  failed
  cancelled
}

enum PayoutApprovalDecision {
  approved
  rejected
}

enum LedgerEntryType {
  due_payment
  refund
  payout
  manual_credit
}

enum LedgerDirection {
  credit
  debit
}

enum PollStatus {
  draft
  active
  closed
}

enum ReferralStatus {
  pending
  joined
  paid
}

enum NotificationKind {
  due_reminder
  payment_received
  join_request
  payout_completed
  poll_milestone
  referral_earned
  system
}

enum NotificationTone {
  brand
  amber
  rose
}

enum KycStatus {
  unverified
  pending
  verified
  rejected
}

enum DisputeStatus {
  open
  under_review
  resolved
}

enum DisputeType {
  payment_not_reflecting
  non_remittance
  refund_request
}

enum RiskTier {
  low
  medium
  high
}

enum FlagStatus {
  pending
  paid
  voided
  clawed_back
}

enum ReportScope {
  financial_summary
  space_collection
  rep_performance
  full_ledger
}

enum ReportFormat {
  csv
  pdf
}

enum ReportStatus {
  generating
  ready
  expired
}

enum SpaceJoinRequestStatus {
  pending
  approved
  rejected
}

enum AuditAction {
  payout_requested
  due_published
  due_closed
  due_created
  poll_created
  members_approved
  profile_updated
  rep_invited
  rep_removed
  code_regenerated
  lead_transferred
  space_archived
  due_reassigned
  payout_approval_cast
  payout_disbursement_started
  payout_cancelled
}

enum AssistantIntent {
  pay_dues
  join_department
  check_balance
  view_history
  contact_rep
  fund_wallet
  create_due
  rep_summary
  unknown
}

enum AssistantRole {
  user
  assistant
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  emailVerified         Boolean              @default(false)
  passwordHash          String?
  phone                 String?
  avatarUrl             String?
  role                  Role                 @default(student)
  repApplicationStatus  RepApplicationStatus @default(none)
  adminSubRole          AdminSubRole?
  matricNo              String?
  level                 String?
  notificationPrefs     Json?                // §3.4 — email/push toggles; null = defaults
  referralCode          String?              @unique
  // Anchor identity. The rep is an Anchor IndividualCustomer; the space's
  // deposit account is owned by this customer record, so no space can collect
  // until kycStatus reaches `verified`. Driven by the
  // customer.identification.* webhooks — the admin override at
  // PATCH /admin/users/:id/kyc exists for support, but Anchor is the source of
  // truth. The BVN is submitted to Anchor and NEVER persisted (PRD §8), which
  // is why a failed check has to be re-entered by the rep rather than retried
  // from stored data.
  anchorCustomerId      String?              @unique
  kycStatus             KycStatus            @default(unverified)
  kycDocUrls            String[]             @default([])
  kycSubmittedAt        DateTime?
  kycResolvedAt         DateTime?
  kycRejectionReason    String?
  kycAttempts           Int                  @default(0)
  kycRetryLockedUntil   DateTime?            // §9.2 — 24h lock after 3 consecutive failures
  // Address is required by Anchor at customer creation. Collected once at KYC
  // submission and kept so the customer can be recreated without re-asking.
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?              // Anchor's enum casing, e.g. "OYO", "AKWA_IBOM"
  postalCode            String?
  isSuspended           Boolean              @default(false)
  suspendedReason       String?
  isDeactivated         Boolean              @default(false)
  deactivatedReason     String?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relations
  refreshTokens         RefreshToken[]
  emailVerifications    EmailVerification[]
  passwordResets        PasswordReset[]
  spaceMemberships      SpaceMembership[]
  spaceReps             SpaceRep[]
  spaceJoinRequests     SpaceJoinRequest[]
  duePayments           DuePayment[]
  transactions          Transaction[]
  notifications         Notification[]
  pollVotes             PollVote[]
  referralsMade         Referral[]           @relation("referrer")
  referralReceived      Referral?            @relation("referred")
  discountCodes         DiscountCode[]
  adminPermissions      AdminPermission?
  disputes              Dispute[]
  idempotencyKeys       IdempotencyKey[]
  sessions              Session[]
  assistantConversations AssistantConversation[]
  assignedDues          Due[]                    @relation("DueAssignedRep")
  requestedPayouts      Payout[]                 @relation("PayoutRequestedBy")
  payoutApprovals       PayoutApproval[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  device    String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  device    String?
  ip        String?
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Spaces
// ---------------------------------------------------------------------------

model Space {
  id             String      @id @default(cuid())
  name           String
  short          String      // 2-6 chars, monogram
  kind           SpaceKind
  hue            EmblemHue   @default(emerald)
  theme          SpaceTheme  @default(emerald)
  about          String?
  faculty        String?
  school         String
  joinCode       String      @unique
  requireApproval Boolean    @default(false)
  isArchived     Boolean     @default(false)
  archivedAt     DateTime?
  archivedReason String?
  payoutsFrozen  Boolean     @default(false)
  frozenReason   String?
  // The space's Anchor deposit account — a SAVINGS account owned by the lead
  // rep's verified IndividualCustomer. Provisioned from the
  // customer.identification.approved webhook, never from the client, so a rep
  // who closes the tab still ends up set up (PRD §6.2). Every checkout's
  // virtual NUBAN settles here, and payouts are drawn from here.
  //
  // anchorAccountNumber/anchorBankName are populated once Anchor assigns the
  // NUBAN, which happens asynchronously after account creation.
  anchorAccountId           String?  @unique
  anchorAccountNumber       String?
  anchorBankName            String?
  anchorAccountStatus       String?  // ACTIVE | BLOCKED | CLOSED | DEPRECATED
  // The rep's payout bank account, registered with Anchor as a CounterParty.
  anchorCounterPartyId      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  memberships    SpaceMembership[]
  reps           SpaceRep[]
  joinRequests   SpaceJoinRequest[]
  dues           Due[]
  bankAccount    BankAccount?
  payouts        Payout[]
  polls          Poll[]
  auditLogs      SpaceAuditLog[]
  repApplication RepApplication?
  ledgerEntries  LedgerEntry[]

  @@map("spaces")
}

model SpaceMembership {
  id         String              @id @default(cuid())
  userId     String
  spaceId    String
  kind       SpaceMembershipKind @default(member)
  joinedAt   DateTime            @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_memberships")
}

model SpaceRep {
  id      String  @id @default(cuid())
  userId  String
  spaceId String
  role    RepRole @default(co)
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_reps")
}

model SpaceJoinRequest {
  id        String                 @id @default(cuid())
  userId    String
  spaceId   String
  status    SpaceJoinRequestStatus @default(pending)
  createdAt DateTime               @default(now())
  resolvedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_join_requests")
}

// Holds pending rep application data (submitted at signup, provisioned on admin approve)
model RepApplication {
  id              String    @id @default(cuid())
  userId          String    @unique
  spaceId         String?   @unique // set once space is provisioned on approval
  spaceName       String
  spaceShort      String
  spaceKind       SpaceKind
  school          String
  faculty         String?
  theme           SpaceTheme
  coRepInvites    String[]  @default([])
  referralCode    String?
  status          RepApplicationStatus @default(pending)
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  space Space? @relation(fields: [spaceId], references: [id])

  @@map("rep_applications")
}

model SpaceAuditLog {
  id          String      @id @default(cuid())
  spaceId     String
  actorId     String
  actorName   String
  actorRole   RepRole?    // the actor's SpaceRep role at write time; null for historical rows
  action      AuditAction
  description String
  createdAt   DateTime    @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, createdAt])
  @@map("space_audit_logs")
}

// ---------------------------------------------------------------------------
// Dues
// ---------------------------------------------------------------------------

model Due {
  id          String       @id @default(cuid())
  spaceId     String
  title       String
  note        String?
  amount      Int          // kobo
  dueDate     DateTime     // YYYY-MM-DD
  category    DueCategory
  status      RepDueStatus @default(draft)
  allowGuests Boolean      @default(false)
  publishedAt DateTime?
  closedAt    DateTime?
  lastRemindedAt DateTime? // §7.7 reminder cooldown
  assignedRepId String?    // the rep whose due-scoped payout access this due is scoped to
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  payments    DuePayment[]
  payouts     Payout[]
  assignedRep User?        @relation("DueAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([spaceId])
  @@index([assignedRepId])
  @@map("dues")
}

model DuePayment {
  id          String    @id @default(cuid())
  userId      String
  dueId       String
  txnId       String?   @unique
  paidAt      DateTime  @default(now())
  // NOT unique: one checkout can settle several dues at once (PRD §5.2), and
  // every DuePayment it creates shares the checkout's reference. Uniqueness is
  // carried by @@unique([userId, dueId]) below — a due is paid once per user.
  reference   String
  amountPaid  Int       // kobo — this line's share of the charge (face + its 2%)
  processingFee Int     // kobo — Anchor's expected cut, taken out of the 2%
  duevyFee    Int       // kobo — Duevy's margin, the rest of the 2%
  netToSpace  Int       // kobo — amountPaid - processingFee - duevyFee, i.e. the face value
  // The checkout's single-use Pay With Transfer account. Anchor fixes the
  // amount and enforces the expiry, so an inflow here is always exactly
  // `amountPaid` and never arrives late (PRD §5.2).
  payWithTransferId     String?
  checkoutAccountNumber String?
  checkoutExpiresAt     DateTime?
  // payin.received — the money is in DUEVY'S settlement account, not the
  // department's. Collected, but not yet the rep's.
  settledAt   DateTime?
  // Set once netToSpace has been book-transferred ON to the space's own deposit
  // account (see remitToSpaces()). This — not settledAt — is what
  // computeBalances() gates "available to pay out" on, because until it is set
  // the money is still sitting with Duevy.
  //
  // remitTransferId is provider-neutral on purpose: rows predating Anchor hold
  // Bachs transfer ids and keep them, as the only audit trail for those moves.
  remittedAt      DateTime?
  remitTransferId String?

  user        User        @relation(fields: [userId], references: [id])
  due         Due         @relation(fields: [dueId], references: [id])
  transaction Transaction? @relation(fields: [txnId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([userId, dueId])
  @@index([dueId])
  @@index([reference])
  @@map("due_payments")
}

// ---------------------------------------------------------------------------
// Wallet & Transactions
// ---------------------------------------------------------------------------

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  type          TxnType
  title         String
  detail        String?
  amount        Int       // kobo, signed
  method        String    // "Wallet" (legacy rows) | "Anchor"
  status        TxnStatus @default(pending)
  reference     String    @unique
  spaceId       String?
  refundOfTxnId String?   // set on `type: refund` rows — the transaction this refund reverses
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  duePayment DuePayment?
  refundOf   Transaction?  @relation("TransactionRefunds", fields: [refundOfTxnId], references: [id])
  refunds    Transaction[] @relation("TransactionRefunds")
  ledgerEntries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([refundOfTxnId])
  @@map("transactions")
}

model PendingPayment {
  id        String    @id @default(cuid())
  reference String    @unique
  userId    String
  type      String    // "topup" | "due_payment" | "poll_vote"
  metadata  Json      // stores dueId, pollId, the checkout virtual account, etc.
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([reference])
  @@map("pending_payments")
}

// Webhook idempotency (PRD §6.4). Anchor delivers AtLeastOnce, so every event
// is persisted by its Anchor event id BEFORE it is processed and a repeated id
// is acknowledged and dropped. Persisting first also makes handlers replayable,
// which is what stands in for a durable job queue today — see the note in
// src/routes/webhooks.ts.
model WebhookEvent {
  id            String    @id @default(cuid())
  anchorEventId String    @unique
  type          String
  payload       Json
  status        String    @default("received") // received | processed | failed
  error         String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([type, receivedAt])
  @@index([status])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Payouts & Bank Accounts
// ---------------------------------------------------------------------------

model BankAccount {
  id              String   @id @default(cuid())
  spaceId         String   @unique
  bankCode        String
  bankName        String
  accountNumber   String   // stored encrypted
  accountNumberMasked String // "•••• 4021"
  accountName     String
  cooldownUntil   DateTime? // §10.2 — 24h payout hold after an account change
  setAt           DateTime @default(now())
  updatedAt       DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Payout {
  id            String       @id @default(cuid())
  spaceId       String
  dueId         String?      // null = space-wide (lead-only); set = due-scoped
  amount        Int          // kobo — the GROSS debit against the space's available balance
  reference     String       @unique
  status        PayoutStatus @default(pending_approval)
  accountMasked String       // "GTBank •••• 4021"
  note          String?
  requestedById String?      // who requested it — needed to authorize cancellation
  failureReason String?
  // PRD §7.3. Every fee comes out of `amount`, so the four below always sum
  // back to it and the Anchor account reconciles exactly:
  //   netSent leaves as the NIP transfer;
  //   anchorFee + stampDuty are deducted by Anchor as CustomerFee rows;
  //   duevyFee is swept to the revenue account by book transfer.
  // Shown to the rep as "Duevy fee ₦100" (duevyFee + anchorFee) + stamp duty.
  duevyFeeKobo    Int        @default(0)
  anchorFeeKobo   Int        @default(0)
  stampDutyKobo   Int        @default(0)
  netSentKobo     Int        @default(0)
  anchorTransferId String?
  requestedAt   DateTime     @default(now())
  cancelledAt   DateTime?
  settledAt     DateTime?

  space       Space            @relation(fields: [spaceId], references: [id])
  due         Due?             @relation(fields: [dueId], references: [id], onDelete: SetNull)
  requestedBy User?            @relation("PayoutRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvals   PayoutApproval[]
  ledgerEntries LedgerEntry[]

  @@index([spaceId])
  @@index([dueId])
  @@map("payouts")
}

model PayoutApproval {
  id        String                  @id @default(cuid())
  payoutId  String
  repUserId String
  decision  PayoutApprovalDecision
  decidedAt DateTime                @default(now())

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  rep    User   @relation(fields: [repUserId], references: [id], onDelete: Cascade)

  @@unique([payoutId, repUserId])
  @@index([payoutId])
  @@map("payout_approvals")
}

// Append-only double-entry ledger — the audit-grade source of truth for every
// kobo that moves. Additive to DuePayment's fee columns (kept as the
// fast-read summary), written alongside the existing Transaction/DuePayment
// writes at each money-movement site. No .update()/.delete() call on this
// model exists anywhere in application code — same discipline already relied
// on for SpaceAuditLog/AdminAuditLog.
model LedgerEntry {
  id           String          @id @default(cuid())
  spaceId      String
  dueId        String?
  txnId        String?
  duePaymentId String?
  payoutId     String?
  type         LedgerEntryType
  direction    LedgerDirection
  amountKobo   Int             // always positive; direction gives the sign
  grossKobo    Int?
  feeKobo      Int?
  netKobo      Int?
  reference    String          // Transaction.reference / Payout.reference — traceability
  description  String
  actorId      String?         // set for refund / manual_credit (the admin who acted)
  createdAt    DateTime        @default(now())

  space      Space       @relation(fields: [spaceId], references: [id])
  due        Due?        @relation(fields: [dueId], references: [id])
  txn        Transaction? @relation(fields: [txnId], references: [id])
  duePayment DuePayment? @relation(fields: [duePaymentId], references: [id])
  payout     Payout?     @relation(fields: [payoutId], references: [id])

  @@index([spaceId, createdAt])
  @@index([dueId])
  @@index([reference])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Polls & Voting
// ---------------------------------------------------------------------------

model Poll {
  id            String     @id @default(cuid())
  spaceId       String
  title         String
  description   String?
  deadline      DateTime
  status        PollStatus @default(draft)
  membersOnly   Boolean    @default(true)
  paid          Boolean    @default(false)
  amountPerVote Int        @default(0) // kobo
  slug          String     @unique
  totalVotes    Int        @default(0)
  revenue       Int        @default(0) // kobo
  coverImageUrl String?
  themeColor    String?
  publishedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  space      Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  categories PollCategory[]

  @@index([spaceId])
  @@map("polls")
}

model PollCategory {
  id        String   @id @default(cuid())
  pollId    String
  title     String
  imageUrl  String?
  createdAt DateTime @default(now())

  poll     Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  nominees Nominee[]

  @@index([pollId])
  @@map("poll_categories")
}

model Nominee {
  id         String  @id @default(cuid())
  categoryId String
  name       String
  imageUrl   String?
  bio        String?
  code       String?
  votes      Int     @default(0)

  category PollCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pollVotes PollVote[]

  @@index([categoryId])
  @@map("nominees")
}

model PollVote {
  id         String   @id @default(cuid())
  userId     String
  nomineeId  String
  categoryId String
  quantity   Int      @default(1)
  amountPaid Int      @default(0) // kobo
  txnRef     String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  nominee Nominee @relation(fields: [nomineeId], references: [id])

  @@index([userId, categoryId])
  @@map("poll_votes")
}

// ---------------------------------------------------------------------------
// Referrals
// ---------------------------------------------------------------------------

model Referral {
  id         String         @id @default(cuid())
  referrerId String
  referredId String         @unique
  status     ReferralStatus @default(pending)
  reward     Int            @default(0) // kobo — 0 until paid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  referrer User @relation("referrer", fields: [referrerId], references: [id])
  referred User @relation("referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

// Referral reward as a redeemable discount, replacing the old wallet-credit
// model. Owned by exactly one user (the referrer); redeemable only against
// their own due payments. `amountKobo` reduces what the payer is charged —
// capped at the due's own fee (see POST /dues/:dueId/pay) so Duevy never
// pays out of pocket beyond its own platform cut; the rep's netToSpace is
// always untouched by a discount.
model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  amountKobo  Int
  redeemedAt  DateTime?
  dueId       String? // which due it was redeemed against, once used
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("discount_codes")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  tone      NotificationTone @default(brand)
  title     String
  detail    String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------

model Dispute {
  id               String        @id @default(cuid())
  type             DisputeType
  openedById       String
  openedByName     String
  openedByEmail    String
  department       String?
  status           DisputeStatus @default(open)
  slaDays          Int           @default(3)
  txnReference     String?
  description      String
  studentEvidence  Json?
  repEvidence      Json?
  claimedById      String?
  resolution       String?
  refundTxnId      String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  openedBy User @relation(fields: [openedById], references: [id])

  @@index([status])
  @@map("disputes")
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model AdminPermission {
  id             String  @id @default(cuid())
  userId         String  @unique
  userManagement Boolean @default(false)
  payouts        Boolean @default(false)
  disputes       Boolean @default(false)
  overrides      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_permissions")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  role      String
  action    String
  target    String?
  ip        String?
  device    String?
  severity  String   @default("info") // info | warning | critical
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model ReferralFlag {
  id          String     @id @default(cuid())
  referrerId  String
  referredId  String
  referrerName String
  referredName String
  label       String     // rule that fired
  description String
  amount      Int        // kobo at stake
  status      FlagStatus @default(pending)
  note        String?
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([status])
  @@map("referral_flags")
}

model Report {
  id          String       @id @default(cuid())
  requestedById String
  scope       ReportScope
  format      ReportFormat
  status      ReportStatus @default(generating)
  fromDate    DateTime
  toDate      DateTime
  spaceId     String?
  downloadUrl String?
  fileSize    Int?
  generatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([requestedById])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  userId         String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Duey — AI chat assistant
// ---------------------------------------------------------------------------

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           AssistantRole
  content        String
  intent         AssistantIntent?
  params         Json?
  confidence     Float?
  createdAt      DateTime        @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}
